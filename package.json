{
  "name": "mctema-launcher",
  "version": "0.2.19",
  "description": "MC Tema Minecraft launcher - offline mode, auto-connect to play.mctema.lt (1.21.11)",
  "main": "main.js",
  "author": "ただし (Discord: noldez)",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "download-jre": "powershell -ExecutionPolicy Bypass -File scripts/download-jre.ps1",
    "dist": "electron-builder",
    "test": "node --test",
    "download-jre-linux": "bash scripts/download-jre.sh",
    "dist-linux": "electron-builder --linux",
    "check-pins": "node scripts/check-cert-pins.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "lt.mctema.launcher",
    "productName": "MC Tema Launcher",
    "directories": {
      "output": "build",
      "buildResources": "buildres"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "!assets/jre/**",
      "lib/**/*"
    ],
    "copyright": "MC Tema - Sukūrė ただし (Discord: noldez)",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "assets/jre",
          "to": "jre"
        },
        {
          "from": "mods",
          "to": "mods"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "include": "installer.nsh",
      "installerSidebar": "sidebar.bmp",
      "uninstallerSidebar": "sidebar.bmp",
      "installerHeader": "header.bmp"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://mctema.lt/updates/",
        "channel": "latest"
      }
    ],
    "artifactName": "MCTemaLauncher-Setup-${version}.${ext}",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Game",
      "executableName": "mctema-launcher",
      "syncDesktopName": true,
      "maintainer": "Noldez <30418741+Noldez@users.noreply.github.com>",
      "artifactName": "MCTemaLauncher-${version}.${ext}",
      "extraResources": [
        {
          "from": "assets/jre-linux",
          "to": "jre"
        },
        {
          "from": "mods",
          "to": "mods"
        }
      ]
    }
  }
}
